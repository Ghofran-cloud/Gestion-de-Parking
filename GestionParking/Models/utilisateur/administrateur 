using System.Collections.Generic;
using System.Text;

namespace GestionParking.Models
{
    public class Administrateur : Utilisateur
    {
        public string Role { get; set; } = "";

        // Administrateur 1 --- 0..* Parking (gère)
        public List<Parking> Parkings { get; set; } = new List<Parking>();

        public void AjouterParking(Parking p)
        {
            if (!Parkings.Contains(p))
                Parkings.Add(p);
        }

        public void AjouterPlace(Parking p, Place pl) => p.AjouterPlace(pl);

        public void ModifierTarif(Tarif t)
        {
            foreach (var p in Parkings)
                p.AjouterOuRemplacerTarif(new Tarif { TypePlace = t.TypePlace, PrixHeure = t.PrixHeure, PrixJour = t.PrixJour });
        }

        public string ConsulterStatistiques()
        {
            var sb = new StringBuilder();
            foreach (var p in Parkings)
                sb.AppendLine($"{p.Nom} : {p.GetNombrePlacesLibres()}/{p.Places.Count} places libres, " +
                              $"taux d'occupation {p.GetTauxOccupation():P0}");
            return sb.ToString();
        }
    }
}
