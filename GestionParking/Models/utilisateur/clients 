using System;
using System.Collections.Generic;
using System.Linq;

namespace GestionParking.Models
{
    public class Client : Utilisateur
    {
        public string Telephone { get; set; } = "";

        public List<Vehicule> Vehicules { get; set; } = new List<Vehicule>();

        public List<Reservation> Reservations { get; set; } = new List<Reservation>();

        public Reservation Reserver(Place place, DateTime debut, DateTime fin, Vehicule vehicule)
        {
            if (fin <= debut)
                throw new ArgumentException("La date de fin doit être après la date de début.");
            if (vehicule == null)
                throw new InvalidOperationException("Veuillez choisir un véhicule.");
            if (!place.EstDisponible(debut, fin))
                throw new InvalidOperationException($"La place {place.Numero} n'est pas disponible sur ce créneau.");

            var reservation = new Reservation
            {
                DateDebut = debut,
                DateFin = fin,
                Client = this,
                Place = place,
                Vehicule = vehicule
            };
            Reservations.Add(reservation);
            place.Reservations.Add(reservation);
            return reservation;
        }

        public void AnnulerReservation(Reservation r)
        {
            if (!Reservations.Contains(r))
                throw new InvalidOperationException("Cette réservation n'appartient pas à ce client.");
            r.Annuler();
        }

        public List<Place> ConsulterPlacesDisponibles(Parking p) => p.GetPlacesDisponibles();

        public List<Reservation> ConsulterHistorique() =>
            Reservations.OrderByDescending(r => r.DateDebut).ToList();

        public void AjouterVehicule(Vehicule v)
        {
            if (Vehicules.Any(x => x.Immatriculation == v.Immatriculation))
                throw new InvalidOperationException("Ce véhicule est déjà enregistré.");
            Vehicules.Add(v);
        }
    }
}
